# ==============================================================================
# TechnoYouth - Variables de Entorno (.env.example)
# ==============================================================================
# Copia este archivo como .env en la carpeta Backend/ y configura tus valores:
#   PowerShell: Copy-Item .env.example .env
# ==============================================================================

# --- SERVIDOR ---
PORT=3000
BASE_URL=http://localhost:3000

RECAPTCHA_SITE_KEY=
RECAPTCHA_SECRET_KEY=

# --- PROVEEDORES SOCIALES (Opcional si usas OAuth directo / Passport) ---
# GOOGLE_CLIENT_ID: Obtenido en Google Cloud Console -> APIs & Services -> Credentials
# GOOGLE_CLIENT_SECRET: Obtenido en Google Cloud Console
# MICROSOFT_CLIENT_ID: Obtenido en Azure Portal -> App Registrations
# MICROSOFT_CLIENT_SECRET: Obtenido en Azure Portal -> Certificates & Secrets
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=

# // TODO-FIREBASE:
# Aquí puedes agregar tus credenciales de Firebase cuando vayas a conectarlo:
# (serviceAccountKey.json en Backend/ o variables de Firebase según tu configuración)
